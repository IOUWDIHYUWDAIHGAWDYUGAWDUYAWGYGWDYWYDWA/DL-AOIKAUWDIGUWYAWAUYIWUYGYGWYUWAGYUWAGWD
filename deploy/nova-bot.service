# Nova botu için systemd servisi (Ubuntu/Debian VM'lerde)
# Kurulum:
#   sudo cp deploy/nova-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nova-bot
[Unit]
Description=Nova Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/nova-bot
EnvironmentFile=/opt/nova-bot/.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
