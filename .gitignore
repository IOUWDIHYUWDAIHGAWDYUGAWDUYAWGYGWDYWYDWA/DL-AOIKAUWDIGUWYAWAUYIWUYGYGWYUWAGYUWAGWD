# Freebuff uygulama verisi (konuşma geçmişi) — asla push edilmez
.freebuff/

# ── Ham kaynak kod: public repo'ya GİRMEZ ──
# Repo'da yalnızca dist/ (şifrelenmiş derleme) bulunur.
# Kaynak değişince: npm run obfuscate && git add dist && git commit
/index.js
/config.js
/config.json
/database.js
/deploy-commands.js
/commands/
/events/
/utils/

# dist içindeki çalışma zamanı dosyaları — veri repo'ya ASLA girmez
/dist/data.db
/dist/data.db.enc

# ── Şifreli derleme: repo'da yalnızca .enc blokları + start.js olur ──
# dist içindeki .js dosyaları, start.js tarafından ÇALIŞMA ANINDA .enc'den
# çözülür; commit'e/repo'ya ASLA girmemeli. (dist/start.js sır içermez, açık kalır.)
/dist/*.js
/dist/**/*.js
!/dist/start.js
