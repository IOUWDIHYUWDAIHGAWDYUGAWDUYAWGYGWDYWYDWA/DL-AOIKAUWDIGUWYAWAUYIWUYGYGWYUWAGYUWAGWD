# Bu dosyayı kopyalayıp ".env" olarak kaydet ve değerleri doldur.
# config.js, ortam değişkeni varsa onu kullanır; yoksa config.json'a bakar.
# Boş bırakılan satırlar config.json'daki değerlerle doldurulur.

TOKEN=
CLIENT_ID=
GUILD_ID=
REQUIRED_ROLE_ID=
ADMIN_ROLE_IDS=
ADMIN_USER_IDS=
RANK_CONTROL_ROLE_ID=
FOUNDER_USER_IDS=
LOG_CHANNEL_ID=
STAY_VOICE_CHANNEL_ID=
WARNING_ROLES={"1":"","2":"","3":"","4":""}
BLACKLIST_ROLE_ID=

# Veritabanı dosyasının yolu (opsiyonel). Docker'da kalıcı volume'e işaret eder:
# DB_PATH=/app/data/data.db
DB_PATH=
