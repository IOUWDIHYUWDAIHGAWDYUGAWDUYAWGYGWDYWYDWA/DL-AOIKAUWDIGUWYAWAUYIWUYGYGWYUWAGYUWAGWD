# ⚙️ Nova Bot — ortam değişkenleri (config.json'u ezer)
# Bu dosyayı kopyalayıp ".env" olarak kaydet ve değerleri doldur.
# config.js, ortam değişkeni varsa onu kullanır; yoksa config.json'a bakar.
# Boş bırakılan satırlar config.json'daki değerlerle doldurulur.

TOKEN=
CLIENT_ID=
GUILD_ID=
REQUIRED_ROLE_ID=
ADMIN_ROLE_IDS=
ADMIN_USER_IDS=
RANK_CONTROL_ROLE_ID=
FOUNDER_USER_IDS=
LOG_CHANNEL_ID=
STAY_VOICE_CHANNEL_ID=
WARNING_ROLES={"1":"","2":"","3":"","4":""}
BLACKLIST_ROLE_ID=

# Tam sıfırlama komutunun (s!fırl@ma) şifresi. Yerel çalıştırmada boş
# bırakılırsa config.json'daki resetPassword değeri kullanılır; GitHub'da
# yalnızca secret olarak gelir (repo'ya asla düşmez).
RESET_PASSWORD=

# Veritabanı dosyasının yolu (opsiyonel). Docker'da kalıcı volume'e işaret eder:
# DB_PATH=/app/data/data.db
DB_PATH=

# Veritabanı şifreleme anahtarı (yalnızca GitHub Actions'ta kullanılır).
# Yerel çalıştırmada GEREKMEZ — yerel data.db zaten repoya gitmez.
# Üretmek için: node scripts/db-crypto.js keygen
# Sonra GitHub → Settings → Secrets and variables → Actions → DB_KEY olarak ekle.
# DB_KEY=

# 🔑 Kaynak kod şifreleme anahtarı — dist/**/*.js.enc dosyalarını çözer.
# Repo'da kaynak düz metin YOKTUR; bot SOURCE_KEY ile çalışır.
# Yerel .env'de de aynı değer olmalı (npm start için).
# Üretmek için: node scripts/db-crypto.js keygen (aynı 64-hex formatı)
# GitHub → Settings → Secrets and variables → Actions → SOURCE_KEY olarak ekle.
# SOURCE_KEY=

# ☁️ Harici DB yedeği (Telegram) — GitHub Actions'ta kullanılır, repo dışı kopya.
# Kurulum: DEPLOY.md → "Telegram yedeği" bölümü.
# TELEGRAM_TOKEN=123456:ABC... (BotFather'dan alınan bot token'ı)
# TELEGRAM_CHAT_ID=-1001234567890 (özel kanal) veya kendi kullanıcı ID'n
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# 🍪 YouTube çerezleri (OPSİYONEL ama önerilir) — GitHub Actions'un veri
# merkezi IP'sinde YouTube "Sign in to confirm you're not a bot" diyebiliyor.
# Çözüm: tarayıcında youtube.com'a girişliyken çerezleri kopyala
# (ör. "Get cookies.txt LOCALLY" eklentisi ile) ve YT_COOKIE olarak
# GitHub → Settings → Secrets and variables → Actions'a ekle.
# Boşsa: metin aramaları otomatik SoundCloud'a düşer, YouTube linkleri hata verir.
YT_COOKIE=

# 🔧 yt-dlp yolu (opsiyonel) — GitHub Actions ve Docker'da otomatik kurulur.
# Kendi makinende çalıştırıyorsan ve yt-dlp PATH'te değilse tam yol yaz:
# YTDLP_BIN=C:\Users\...\yt-dlp.exe  (Windows) veya /usr/local/bin/yt-dlp (Linux)
YTDLP_BIN=
