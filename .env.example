[TEMPLATE]
[TEMPLATE]
# Bu dosyayı kopyalayıp ".env" olarak kaydet ve değerleri doldur.
# config.js, ortam değişkeni varsa onu kullanır; yoksa config.json'a bakar.
# Boş bırakılan satırlar config.json'daki değerlerle doldurulur.

TOKEN=
CLIENT_ID=
GUILD_ID=
REQUIRED_ROLE_ID=
ADMIN_ROLE_IDS=
ADMIN_USER_IDS=
RANK_CONTROL_ROLE_ID=
FOUNDER_USER_IDS=
LOG_CHANNEL_ID=
STAY_VOICE_CHANNEL_ID=
WARNING_ROLES={"1":"","2":"","3":"","4":""}
BLACKLIST_ROLE_ID=

# Veritabanı dosyasının yolu (opsiyonel). Docker'da kalıcı volume'e işaret eder:
# DB_PATH=/app/data/data.db
DB_PATH=

# Veritabanı şifreleme anahtarı (yalnızca GitHub Actions'ta kullanılır).
# Yerel çalıştırmada GEREKMEZ — yerel data.db zaten repoya gitmez.
# Üretmek için: node scripts/db-crypto.js keygen
# Sonra GitHub → Settings → Secrets and variables → Actions → DB_KEY olarak ekle.
# DB_KEY=

# ☁️ Harici DB yedeği (Telegram) — GitHub Actions'ta kullanılır, repo dışı kopya.
# Kurulum: DEPLOY.md → "Telegram yedeği" bölümü.
# TELEGRAM_TOKEN=123456:ABC... (BotFather'dan alınan bot token'ı)
# TELEGRAM_CHAT_ID=-1001234567890 (özel kanal) veya kendi kullanıcı ID'n
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
